# Public Mapbox token used by Mapbox GL JS. Use a restricted pk.* token.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional Mapbox style override. Defaults in code to mapbox/navigation-night-v1.
VITE_ATLAS_MAPBOX_STYLE=mapbox/navigation-night-v1

# Optional HTTP fallback for the Raspberry Pi API. BLE remains the primary vehicle link.
# Examples: http://raspberrypi.local:5000, http://192.168.0.209:5000, http://100.x.y.z:5000
VITE_PI_API_BASE=

# Optional development radar worker base. Production tablet radar is on-device native Android.
VITE_RADAR_API_BASE=http://localhost:8787

# Development-only simulator fallback. Do not rely on this for field validation.
VITE_ALLOW_SIMULATOR=false

# Optional diagnostics/development switches.
VITE_ATLAS_DIAGNOSTICS=0
VITE_ATLAS_DISABLE_STYLE_TUNE=0
VITE_ATLAS_RADAR_FIXTURE=0
