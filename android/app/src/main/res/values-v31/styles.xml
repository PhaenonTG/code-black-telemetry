<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ (API 31+) SplashScreen API renders its own icon-on-background splash before
         the Capacitor plugin's own @drawable/splash overlay ever gets a chance to show, and
         defaults to the app's launcher icon (the generic tornado mark) if not told otherwise,
         a mismatch against the app's actual Code Black shield branding that this overrides. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#070707</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#070707</item>
    </style>

</resources>
