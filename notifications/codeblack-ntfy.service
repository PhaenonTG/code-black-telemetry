[Unit]
Description=Code Black private ntfy notifications
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ntfy
Group=ntfy
ExecStart=/usr/local/bin/ntfy serve
Restart=on-failure
RestartSec=5
StateDirectory=ntfy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ntfy
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
