{
  "name": "code-black-telemetry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/launch-webapp.ps1",
    "release:sanity": "node scripts/release-sanity.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.2.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "mapbox-gl": "^3.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
