+
+  .ops-header {
+    grid-template-columns: 1fr;
+    grid-template-rows: 54px 46px;
+    height: calc(var(--cb-header-h) - 8px);
+    padding: 6px;
+  }
+
+  .brand-lockup {
+    padding: 6px 16px;
+  }
+
+  .brand-title {
+    font-size: 28px;
+  }
+
