+}
+
+/* OPERATION BLACKOUT VISUAL SYSTEM */
+:root {
+  --bg: #020202;
+  --panel: #090a0c;
+  --panel-2: #111316;
+  --border: #24272d;
+  --text: #f5f7fb;
