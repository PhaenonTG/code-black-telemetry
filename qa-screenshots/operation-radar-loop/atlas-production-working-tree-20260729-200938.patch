+  .brand-subtitle,
+  .gps-strip,
+  .unit-strip {
+    font-size: 9px;
+  }
+
+  .metric-tile,
+  .metric-grid div {
+    min-height: 50px;
+    padding: 7px 8px 6px;
+  }
+
+  .metric-tile strong,
+  .metric-grid strong {
+    font-size: clamp(18px, 1.6vw, 25px);
+  }
+
+  .wx-panel .metric-tile strong {
+    font-size: clamp(16px, 1.18vw, 21px);
+  }
+
+  .wind-compass {
+    width: min(24dvh, 180px);
+  }
+
+  .wind-readout strong {
+    font-size: clamp(52px, 5.1vw, 76px);
+  }
+
+  .alert-pill {
+    min-height: 54px;
+  }
+
+  .threat-card {
+    min-height: 64px;
+  }
+
+  .bottom-dock {
+    height: calc(var(--cb-dock-h) - 8px);
+    grid-template-columns: repeat(5, minmax(0, 1fr)) minmax(160px, 0.7fr);
