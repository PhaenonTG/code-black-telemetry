+  .loc-panel { grid-area: loc; }
+  .wx-panel { grid-area: weather; }
+  .wind-panel { grid-area: wind; }
+  .alerts-panel { grid-area: alerts; }
+  .map-panel { grid-area: map; min-height: 42dvh; }
+  .threats-panel { grid-area: threats; }
