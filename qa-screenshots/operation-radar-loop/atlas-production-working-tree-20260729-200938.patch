+  --gap: clamp(8px, 0.95dvh, 13px);
+  --radius: 8px;
+  --cut: polygon(0 10px, 10px 0, calc(100% - 10px) 0, 100% 10px, 100% calc(100% - 10px), calc(100% - 10px) 100%, 10px 100%, 0 calc(100% - 10px));
