[Unit]
Description=Code Black Aegis supplemental warning-triggered radar screen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cbwx-core
Group=cbwx-core
WorkingDirectory=/srv/codeblack/releases/aegis-warning/v6
Environment=CODEBLACK_AEGIS_RADAR_DATA=/srv/codeblack/data/radar-worker/aegis-warning
Environment=CODEBLACK_AEGIS_RADAR_CONFIG=/srv/codeblack/data/radar-worker/aegis-warning/config.json
ExecStart=/usr/bin/flock -n /srv/codeblack/data/radar-worker/aegis-warning/.run.lock /usr/bin/node /srv/codeblack/releases/aegis-warning/v6/aegis-warning.cjs
TimeoutStartSec=240
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/codeblack/data/radar-worker/aegis-warning
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=2G
StandardOutput=journal
StandardError=journal
