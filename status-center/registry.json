  "services": [
    {
      "id": "core-api",
      "name": "Core API",
      "host": "core",
      "category": "core",
      "role": "Fabric/chase/storm-intel API",
      "critical": true,
      "unit": "codeblack-core-api",
      "probe": "core_api",
      "release_symlink": "core-api",
      "deps": [],
      "urls": {
        "local": "http://127.0.0.1:8000/",
        "health": "http://127.0.0.1:8000/health"
      },
      "docs": "/srv/codeblack/CORE_ROLLOUT_STATUS.md (Core host)"
    },
    {
      "id": "nick-mesonet-wind",
      "name": "Nick Mesonet · WIND",
      "host": "core",
      "category": "weather",
      "role": "ESP32 anemometer uplink; status is Core report freshness, not sensor validity",
      "mesonet_role": "wind",
      "host_impact": false,
      "probe": "mesonet_latest",
      "deps": ["core-api"],
      "urls": {},
      "docs": "firmware/mesonet-idf/README.md (Nick Mesonet project)"
    },
    {
      "id": "nick-mesonet-weather",
      "name": "Nick Mesonet · WEATHER",
      "host": "core",
      "category": "weather",
      "role": "ESP32 temperature/RH and optional GPS uplink; status is Core report freshness, not sensor validity",
