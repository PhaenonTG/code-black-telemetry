    },
    {
      "id": "monitor_health",
      "kind": "http_json",
      "url": "http://127.0.0.1:8896/api/source-health",
      "interval": "fast"
    },
    {
      "id": "radar_product",
      "kind": "http_json",
      "url": "http://127.0.0.1:8791/v1/composite/latest.json",
