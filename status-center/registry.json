          "expect": "blocked"
        }
      ]
    },
    {
      "id": "pihole_dns_ts",
      "kind": "dns",
      "server": "100.88.198.67",
      "port": 53,
      "interval": "slow",
      "queries": [
        {
          "name": "resolves example.com",
          "qname": "example.com",
          "expect": "answer"
        },
        {
          "name": "blocks ads.google.com",
          "qname": "ads.google.com",
          "expect": "blocked"
        }
      ]
    },
    {
      "id": "pihole_web_lan",
      "kind": "http_json",
      "url": "http://192.168.0.12/admin/",
      "interval": "slow",
      "no_json": true,
      "accept": [
        200,
        301,
        302,
        401,
        403
      ]
    },
    {
      "id": "pihole_web_ts",
      "kind": "http_json",
      "url": "http://100.88.198.67/admin/",
      "interval": "slow",
      "no_json": true,
      "accept": [
        200,
        301,
        302,
        401,
        403
      ]
    },
    {
      "id": "core_collector",
      "kind": "collector_local",
      "host": "core",
      "interval": "host"
    },
    {
      "id": "edge_collector",
      "kind": "collector",
      "host": "edge",
      "interval": "host"
    },
    {
      "id": "phaenon3_collector",
      "kind": "collector",
      "host": "phaenon3",
      "interval": "host"
    },
    {
      "id": "medialab_health",
      "kind": "http_json",
      "url": "https://phaenon3.tail1d0673.ts.net/api/health",
      "interval": "host",
      "pick": [
        "ok",
        "name",
        "version"
      ],
      "ok_json": {
        "path": "ok",
        "in": [
          true
        ]
      }
    },
    {
      "id": "medialab_system",
      "kind": "http_json",
      "url": "https://phaenon3.tail1d0673.ts.net/api/system",
      "interval": "host",
      "pick": [
        "gpu",
        "memory",
        "priority"
      ]
    },
    {
      "id": "medialab_download",
      "kind": "http_json",
      "url": "https://phaenon3.tail1d0673.ts.net/api/download",
      "interval": "host",
      "pick": [
        "ready",
        "workflow",
        "quant",
        "download.state",
        "download.bytes",
        "download.expected_bytes",
        "download.percentage",
        "download.current_rate_bps",
        "download.retry_count",
        "download.last_progress_timestamp",
        "download.integrity_verification",
        "download.message",
        "download.updated_at",
        "files.diffusion.checksum_verified"
