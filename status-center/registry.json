          "expect": "answer"
        }
      ]
    },
    {
      "id": "pihole_dns_lan",
      "kind": "dns",
      "server": "192.168.0.12",
      "port": 53,
      "interval": "slow",
      "queries": [
        {
          "name": "resolves example.com",
          "qname": "example.com",
          "expect": "answer"
        },
        {
          "name": "resolves github.com",
          "qname": "github.com",
