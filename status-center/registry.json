    },
    {
      "id": "sandbox_health",
      "kind": "http_json",
      "url": "https://phaenon3.tail1d0673.ts.net/image-sandbox/api/health",
      "interval": "host",
      "pick": [
        "draft.available",
        "draft.device",
        "quality.state",
        "quality.model",
        "quality.required_free_mib",
        "quality.gpu.free_mib",
        "quality.gpu.used_mib",
        "quality.gpu.utilization_percent"
      ]
    },
    {
      "id": "ai_health",
      "kind": "http_json",
      "url": "https://phaenon3.tail1d0673.ts.net/ai/health",
      "interval": "host",
      "pick": [
        "status",
        "service",
        "version",
        "build",
        "started_at",
        "ollama_reachable",
        "general_model_ready",
        "vision_model_ready",
        "coder_model_ready",
        "models_available",
        "status_adapter.state",
        "status_adapter.last_sync",
        "status_adapter.schema",
        "status_adapter.source_generated_at",
        "status_adapter.source_age_s",
        "status_adapter.consecutive_failures"
