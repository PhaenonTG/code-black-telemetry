{
  "schema": "codeblack.status-registry.v1",
  "instance": {
    "name": "Code Black System Status Center",
    "public_base": "https://codeblack-core.tail1d0673.ts.net/status/",
    "tailnet": "tail1d0673.ts.net"
  },
  "defaults": {
    "fast_s": 8,
    "host_s": 15,
    "slow_s": 60,
    "probe_timeout_s": 4,
    "stale_factor": 3
  },
  "thresholds": {
    "disk": {
      "warn_pct": 85,
      "crit_pct": 97,
      "warn_free_gb": 25,
      "crit_free_gb": 10
    },
    "weather_ingest_s": {
      "fresh": 5400,
      "aging": 10800,
      "stale": 21600
    },
    "weather_watcher_s": {
      "fresh": 1800,
      "aging": 3600,
      "stale": 10800
    },
    "backup_age_s": {
      "warn": 129600,
      "crit": 259200
    },
    "verification_age_s": {
      "warn": 172800,
      "crit": 345600
    }
  },
  "hosts": [
    {
      "id": "core",
      "name": "CORE",
      "role": "Operational core: stream ingest, monitor, radar, Core API, MQTT",
      "lan_ip": "192.168.0.187",
      "tailscale_ip": "100.96.77.89",
      "tailscale_peer": "codeblack-core",
      "expected_online": true,
      "critical": true,
      "collector": {
        "mode": "in-process"
      },
      "checks": {
        "disks": [
          "/"
        ],
        "units": [
          "codeblack-core-api",
          "codeblack-mesonet-alerts",
          "mediamtx",
          "codeblack-monitor",
          "codeblack-radar-worker",
          "codeblack-radar-product",
          "codeblack-overlay",
          "codeblack-overlay-dev",
          "codeblack-mqtt-broker",
          "codeblack-mqtt-bridge",
          "codeblack-owntracks-bridge",
          "codeblack-ai",
          "ollama",
          "cloudflared",
          "tailscaled",
          "codeblack-status-center"
        ],
        "symlinks": [
          {
            "name": "core-api",
            "path": "/srv/codeblack/services/core-api-current"
          },
          {
            "name": "monitor",
            "path": "/srv/codeblack/services/monitor-current"
          },
          {
            "name": "overlay",
            "path": "/srv/codeblack/services/overlay-current"
          },
          {
            "name": "radar-product",
            "path": "/srv/codeblack/releases/radar-product/current"
          },
          {
            "name": "status-center",
            "path": "/srv/codeblack/releases/status-center/current"
          }
        ]
      }
    },
    {
      "id": "edge",
      "name": "EDGE",
      "role": "Edge infrastructure: Pi-hole DNS, weather intelligence, notifications, backups",
      "lan_ip": "192.168.0.12",
      "tailscale_ip": "100.88.198.67",
      "tailscale_peer": "codeblack-edge",
      "expected_online": true,
      "critical": true,
      "collector": {
        "mode": "remote",
        "url": "http://100.88.198.67:9110/v1/metrics",
        "bind": "100.88.198.67",
        "port": 9110
      },
      "checks": {
        "disks": [
          "/"
        ],
        "units": [
          "pihole-FTL",
          "codeblack-edge-status",
          "codeblack-edge-dashboard",
          "codeblack-discord-bot",
          "tailscaled",
          "codeblack-functional-probes.timer",
          "codeblack-weather-ingest.timer",
          "codeblack-weather-publication-watcher.timer",
          "codeblack-weather-ingest.service",
          "codeblack-weather-publication-watcher.service",
          "codeblack-core-health.timer",
          "codeblack-edge-health.timer",
          "codeblack-core-backup.timer",
          "codeblack-core-backup.service",
          "codeblack-backup-verify.timer",
          "codeblack-backup-verify.service",
          "codeblack-edge-alert-evaluate.timer",
          "codeblack-edge-reliability.timer",
          "codeblack-edge-status-collect.timer",
          "codeblack-fleet-presence.timer",
          "codeblack-notification-dispatch.timer",
          "codeblack-ops-infrastructure.timer"
        ],
        "files": [
          {
            "name": "functional-probes",
            "path": "/srv/codeblack/data/status/functional-probes.json",
            "pick": [
              "status",
              "core_api.ok",
              "mqtt.connect_latency_ms",
              "phaenon3.ok",
              "phaenon3.status",
              "phaenon3.gpu.used_mb",
              "phaenon3.gpu.total_mb",
              "phaenon3.learning_queue.currently_running",
              "phaenon3.learning_queue.last_result"
            ]
          },
          {
            "name": "stream-state",
            "path": "/srv/codeblack/data/status/stream.json",
            "pick": [
              "source",
              "availability",
              "checked_at",
              "last_error"
            ]
          },
          {
            "name": "backup-verification",
            "path": "/srv/codeblack/data/status/backup-verification.json",
            "pick": [
              "status",
              "generated_at",
              "snapshot",
              "backup_complete",
              "inventory_present",
              "repositories_checked",
              "repositories_expected"
            ]
          },
          {
            "name": "notification-status",
            "path": "/srv/codeblack/data/status/notification-status.json",
            "pick": [
              "generated_at",
              "enabled",
              "configured",
              "queue.outbox",
              "queue.failed",
              "last_result"
            ]
          },
          {
            "name": "edge-status-json",
            "path": "/srv/codeblack/data/status/status.json"
          },
          {
            "name": "ops-infrastructure-json",
            "path": "/srv/codeblack/data/status/ops-infrastructure.json"
          },
          {
            "name": "fleet-presence-json",
            "path": "/srv/codeblack/data/status/fleet-presence.json"
          }
        ],
        "newest": [
          {
            "name": "hrrr-grib",
            "dir": "/srv/codeblack/data/weather-cache/grib",
            "pattern": "\\.grib2$",
            "depth": 0
          },
          {
            "name": "core-snapshots",
            "dir": "/srv/codeblack/backups/core/snapshots",
            "dirs": true,
            "pattern": "^\\d{8}T\\d{6}Z$"
          }
        ],
        "commands": [
          "pihole_version"
        ]
      }
    },
    {
      "id": "phaenon3",
      "name": "PHAENON3",
      "role": "Shared GPU compute: AEGIS/AI router, AI Lab, Spencer Labs (also a gaming PC; node.json marks it non-authoritative)",
      "lan_ip": "192.168.0.231",
      "tailscale_ip": "100.66.216.11",
      "tailscale_peer": "PHAENON3",
      "expected_online": true,
      "critical": false,
      "collector": {
        "mode": "remote",
        "url": "https://phaenon3.tail1d0673.ts.net/status-collector/v1/metrics",
        "bind": "127.0.0.1",
        "port": 9110
      },
      "checks": {
        "gpu": true,
        "disks": [
          "C:\\"
        ],
        "units": [
          "CodeBlack-AI-Router",
          "CodeBlack Aegis Factory Watchdog",
          "CodeBlack-AILab-Deploy",
          "CodeBlack-AILab-HealthWatch",
          "Spencer Labs Media Lab",
          "Spencer Labs Wan 2.2 Q4 Status Monitor",
          "Spencer Labs Wan 2.2 Q4 Verification Watcher",
          "Spencer Labs Wan 2.2 Q4 Download Recovery"
        ],
        "http": [
          {
            "name": "ollama-ps",
            "url": "http://127.0.0.1:11434/api/ps",
            "pick": [
              "names:models"
            ]
          },
          {
            "name": "ollama-version",
            "url": "http://127.0.0.1:11434/api/version",
            "pick": [
              "version"
            ]
          },
          {
            "name": "sandbox-comfy-queue",
            "url": "http://127.0.0.1:8190/queue",
            "pick": [
              "len:queue_running",
              "len:queue_pending"
            ]
          },
          {
            "name": "ailab-health",
            "url": "http://127.0.0.1:8800/health",
            "pick": [
              "ok",
              "state"
            ]
          },
          {
            "name": "ailab-status",
            "url": "http://127.0.0.1:8800/status",
            "pick": [
              "data.mode",
              "data.queue",
              "data.experiments_total",
              "data.proposals_pending"
            ]
          },
          {
            "name": "weather-worker",
            "url": "http://100.66.216.11:8798/health",
            "pick": [
              "status",
              "version",
              "uptime_seconds",
              "latest_received_at"
            ]
          }
        ],
        "files": [
          {
            "name": "weather-watchdog-state",
            "path": "C:\\CodeBlack\\services\\weather-worker\\watchdog-state.json",
            "pick": [
              "weather_worker",
              "supervisor",
              "last_health_check",
              "recovery_count"
            ]
          }
        ]
      }
    },
    {
      "id": "hytetower",
      "name": "HYTETOWER",
      "role": "Streaming workstation (OBS/production; services not documented, reachability only)",
      "lan_ip": "192.168.0.27",
      "tailscale_ip": "100.103.139.120",
      "tailscale_peer": "hytetower",
      "expected_online": true,
      "critical": false,
      "collector": {
        "mode": "none"
      },
      "reach": [
        {
          "probe": "hytetower_rdp",
          "label": "RDP 3389"
        },
        {
          "probe": "hytetower_ssh",
          "label": "SSH 22"
        }
      ],
      "checks": {}
    },
    {
      "id": "raspberrypi",
      "name": "raspberrypi",
      "role": "Raspberry Pi (Tailscale peer; role not documented)",
      "lan_ip": null,
      "tailscale_ip": "100.80.136.32",
      "tailscale_peer": "raspberrypi",
      "expected_online": false,
      "critical": false,
      "collector": {
        "mode": "none"
      },
      "checks": {}
    }
  ],
  "probes": [
    {
      "id": "core_api",
      "kind": "http_json",
      "url": "http://127.0.0.1:8000/health",
      "interval": "host",
      "ok_json": {
        "path": "status",
        "in": [
          "healthy",
          "ok"
        ]
      }
    },
    {
      "id": "mesonet_latest",
      "kind": "mesonet_latest",
      "url": "http://127.0.0.1:8000/api/mesonet/v1/latest",
      "interval": 2
    },
    {
      "id": "core_api_storm",
      "kind": "http_json",
      "url": "http://127.0.0.1:8000/api/storm-intel/v1/health",
      "interval": "slow",
      "ok_json": {
        "path": "status",
        "in": [
          "healthy"
        ]
      }
    },
    {
      "id": "core_api_soundings",
      "kind": "http_json",
      "url": "http://127.0.0.1:8000/api/soundings/v1/health",
      "interval": "slow",
      "ok_json": {
        "path": "status",
        "in": [
          "healthy"
        ]
      }
    },
    {
      "id": "core_api_fabric",
      "kind": "http_json",
      "url": "http://127.0.0.1:8000/api/fabric/v1/health",
      "interval": "slow",
      "ok_json": {
        "path": "status",
        "in": [
          "healthy"
