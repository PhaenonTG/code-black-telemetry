    {
      "id": "hytetower_rdp",
      "kind": "tcp",
      "host": "100.103.139.120",
      "port": 3389,
      "interval": "host"
    },
    {
      "id": "hytetower_ssh",
      "kind": "tcp",
      "host": "100.103.139.120",
      "port": 22,
      "interval": "host"
