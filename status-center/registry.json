    },
    {
      "id": "radar_product_health",
      "kind": "http_json",
      "url": "http://127.0.0.1:8791/v1/health",
      "interval": "slow",
      "pick": [
        "version",
        "ok"
      ]
    },
    {
      "id": "radar_worker",
      "kind": "http_json",
      "url": "http://127.0.0.1:8787/api/v1/radar/health",
      "interval": "host",
      "ok_json": {
        "path": "ok",
        "in": [
          true
        ]
      }
    },
    {
      "id": "overlay_http",
      "kind": "http_json",
      "url": "http://127.0.0.1:8899/",
      "interval": "slow",
      "no_json": true
    },
    {
      "id": "ollama_core",
      "kind": "http_json",
      "url": "http://127.0.0.1:11434/api/version",
      "interval": "slow"
    },
    {
      "id": "mqtt_tcp",
      "kind": "tcp",
      "host": "100.96.77.89",
      "port": 8883,
      "interval": "host"
    },
    {
      "id": "tailscale",
      "kind": "tailscale",
      "interval": "host"
    },
    {
      "id": "internet_dns",
      "kind": "dns",
      "server": "1.1.1.1",
      "port": 53,
      "interval": "slow",
