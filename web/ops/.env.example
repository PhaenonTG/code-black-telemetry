# Public-only values. Never put private OPS credentials, Core auth, or stream keys here.
# Same Mapbox public token convention as the root app -- a "public" token scoped to
# maps/styles read access, not a secret.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_ATLAS_MAPBOX_STYLE=

# Supabase project for Code Black OPS auth (email + password). The publishable key is a
# browser-safe, non-secret key by design -- authorization is enforced server-side by RLS
# on the profiles table, not by keeping this key hidden. Never put the service_role key,
# database password, or a Supabase management token here or anywhere client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
