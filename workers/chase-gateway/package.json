{
  "name": "codeblack-chase-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predeploy": "npm run typecheck && npm test && node scripts/verify-mesonet-contract.mjs pre",
    "deploy": "wrangler deploy",
    "postdeploy": "node scripts/verify-mesonet-contract.mjs live"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
