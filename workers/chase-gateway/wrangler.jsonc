{
  // codeblack-chase-gateway. The deployment binding below was verified from the live Worker
  // version before this configuration was made deployable. CHASE_TOKEN remains a Worker secret.
  "name": "codeblack-chase-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",

  // This is the existing, narrowly scoped public Chase ingress.
  "routes": [{ "pattern": "ops.codeblackwx.com/api/chase/*", "zone_name": "codeblackwx.com" }],

  // Published by the local Chase release script. The directory stays free of secrets.
  "assets": {
    "directory": "./releases",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Workers VPC Service binding to private Core, verified from the deployed Worker version.
  "vpc_services": [
    {
      "binding": "CORE_VPC",
      "service_id": "01a07ab2-e9b9-7072-8d86-bb514e27712c",
      "remote": true
    }
  ]

  // CHASE_TOKEN is a Worker secret (`wrangler secret put CHASE_TOKEN`), never committed here.
}
